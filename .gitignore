# Local .terraform directories
.terraform/

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data, such as
# password, private keys, and other secrets. These should not be part of version 
# control as they are data points which are potentially sensitive and subject 
# to change depending on the environment.
*.tfvars
*.tfvars.json

# Ignore override files as they are usually used to override resources locally and so
# are not checked in
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore transient lock info files created by terraform apply
.terraform.tfstate.lock.info

# Contract #6: lock files exist only at root stacks (terraform/backend-bootstrap,
# terraform/live/*). The template corpus never carries them — any lock file under
# factory/templates/ is local terraform-init debris from validation runs.
factory/templates/**/.terraform.lock.hcl

# Include override files you do wish to add to version control using negated pattern
# !example_override.tf

# Include tfplan files to ignore the plan output of command: terraform plan -out=tfplan
# example: *tfplan*

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Deployment options configuration (user-specific)
.azure/deployment-options.yaml

# Bootstrap state (contains tenant/subscription IDs and app client IDs).
# The legacy bootstrap writes .lz-bootloader-state.json (its -StateFile
# default) and reports under .reports/bootstrap/ — both carry tenant,
# subscription, and app identifiers and must never land in the repo.
.bootstrap-state.json
.lz-bootloader-state.json
.reports/

# Landing Zone Factory — per-company output. Never commit: contains tenant and
# subscription identifiers, and is regenerated from the wizard on demand.
generated-output/

# Stage 9 broker inputs/evidence. These contain tenant, subscription, identity,
# repository, and backend identifiers and are operator-local artifacts.
/lz-config.json
/discovery-inventory.json
# The human-readable sibling of discovery-inventory.json. Rendered by
# New-LzReadinessReport.ps1 from a full tenant inventory, so it carries the
# same tenant/subscription detail. Added 2026-08-19: it was NOT ignored, so a
# discovery run at the repo root could have committed tenant data to a public
# template repository.
/tenant-readiness-report.md
/bootstrap-output/
/rendered-output/
/validate-evidence/
/scaffold-output/

# Client-copy render and validation outputs, written by
# .github/workflows/client-config-check.yml and by the same phases run by hand.
# They carry the same tenant, subscription and identity detail the answer record
# does, so they are ignored for exactly the reason the answer record is.
#
# client/lz-config.json is deliberately NOT ignored: the root ignore above is
# anchored, and the client copy is meant to commit its answers so the check
# workflow has something to render. See client/README.md.
/client-rendered/
/client-evidence/
/client-bootstrap-output/
/client-scaffold-output/
/client-scaffold-evidence/

# Invoke-Discovery.ps1 reads no environment variables and always writes
# discovery-inventory.json BESIDE THE CONFIG FILE, so running the engagement
# against client/lz-config.json puts it — and the readiness report rendered
# from it — inside client/. The entries above are root-anchored and do not
# reach there, which is the same gap that let a discovery run at the repo root
# commit tenant data before 2026-08-19. Both carry tenant, subscription and
# identity detail.
/client/discovery-inventory.json
/client/tenant-readiness-report.md
/scaffold-evidence/
/brownfield-classifications.json
/brownfield-evidence/
/factory-ci-output/
/dogfood-config.json
/dogfood-output/
/dogfood-evidence/
/release-attestation.json
/release-input/
/release-evidence/
*.lz-backup-*/

# Landing Zone Factory test output. Regenerated on every run.
factory/tests/.out/

# Per-session offsets for the agent-report Stop hook (local runtime state)
.claude/.agent-report-state/
