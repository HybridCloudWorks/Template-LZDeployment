# GENERATED FILE — Landing Zone Factory v{{FACTORY-RAW:computed.factoryVersion}}
name: Terraform Apply

on:
  workflow_dispatch:
    inputs:
      environment:
        description: Protected GitHub environment
        required: true
        type: environment
      layer:
        description: Layer to apply (must be one of the rendered layers)
        required: true
        type: choice
        options:
#{{FOREACH lyr IN computed.layers}}
          - {{FACTORY-RAW:lyr}}
#{{ENDFOREACH}}

permissions: {}

concurrency:
  group: terraform-apply-${{ inputs.environment }}-${{ inputs.layer }}
  cancel-in-progress: false

jobs:
  apply:
    name: Apply ${{ inputs.layer }} to ${{ inputs.environment }}
    runs-on: ubuntu-latest
    environment: ${{ inputs.environment }}
    permissions:
      id-token: write
      contents: read
    steps:
      - name: Checkout trusted default branch
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          ref: {{FACTORY-RAW:computed.defaultBranch}}
      - name: Reject unknown layer
        env:
          REQUESTED_LAYER: ${{ inputs.layer }}
          ALLOWED_LAYERS: '{{FACTORY-RAW:computed.layersCsv}}'
        run: |
          case ",$ALLOWED_LAYERS," in
            *",$REQUESTED_LAYER,"*) ;;
            *) echo "::error::Unknown or unrendered layer: $REQUESTED_LAYER"; exit 1 ;;
          esac
      - name: Enforce layer -> environment binding
        env:
          REQUESTED_LAYER: ${{ inputs.layer }}
          REQUESTED_ENVIRONMENT: ${{ inputs.environment }}
        run: |
          # The environment input is free-form (type: environment), but each
          # layer has exactly one canonical protected environment (the broker's
          # Get-LzLayerEnvironment mapping). Without this guard, a layer could
          # be applied through ANOTHER environment's reviewer gate — e.g.
          # workloads-prod through the dev reviewers under the minimal
          # identity model. Runs before Azure login: a mismatched dispatch
          # fails here, before any credential is issued.
          case "$REQUESTED_LAYER" in
            global)                expected="bootstrap" ;;
            platform-connectivity) expected="connectivity" ;;
            platform-management)   expected="management" ;;
            platform-identity)     expected="identity" ;;
            workloads-prod)        expected="prod" ;;
            sandbox)               expected="sandbox" ;;
            workloads-nonprod)
              # Config-dependent (first of dev/test/uat); constrain to the
              # non-production class rather than one exact name.
              case "$REQUESTED_ENVIRONMENT" in
                dev|test|uat) expected="$REQUESTED_ENVIRONMENT" ;;
                *) expected="dev|test|uat" ;;
              esac ;;
            *)                     expected="" ;;
          esac
          if [ -z "$expected" ]; then
            echo "::error::No canonical environment mapping for layer '$REQUESTED_LAYER'."
            exit 1
          fi
          if [ "$REQUESTED_ENVIRONMENT" != "$expected" ]; then
            echo "::error::Layer '$REQUESTED_LAYER' must be applied through its canonical environment '$expected', not '$REQUESTED_ENVIRONMENT'."
            exit 1
          fi
          echo "Layer '$REQUESTED_LAYER' correctly bound to environment '$REQUESTED_ENVIRONMENT'."
      - name: Azure login (environment apply identity)
        uses: azure/login@f5d393ae46f8fde4be8b75f32e3fc50e654ad0ca # v3.0.1
        with:
          client-id: ${{ vars.AZURE_APPLY_CLIENT_ID }}
          tenant-id: {{FACTORY-RAW:azure.tenantId}}
          subscription-id: ${{ vars.AZURE_SUBSCRIPTION_ID }}
      - name: Setup Terraform
        uses: hashicorp/setup-terraform@dfe3c3f87815947d99a8997f908cb6525fc44e9e # v4.0.1
        with:
          terraform_version: '{{FACTORY-RAW:computed.terraformVersion}}'
          # Without this, the wrapper echoes a "[command]..." line ahead of
          # stdout, corrupting the `terraform show -json` redirect below.
          terraform_wrapper: false
      # Backend values live in the layer's backend.hcl; authentication is
      # OIDC + Azure AD from the login step above — no state keys anywhere.
      - name: Initialize
        working-directory: terraform/live/${{ inputs.layer }}
        run: terraform init -input=false -backend-config=backend.hcl
      - name: Create reviewed plan
        working-directory: terraform/live/${{ inputs.layer }}
        run: terraform plan -input=false -no-color -out=tfplan
      - name: Refuse destructive apply
        working-directory: terraform/live/${{ inputs.layer }}
        run: |
          terraform show -json tfplan > plan.json
          destroys=$(jq '[.resource_changes[]? | select(.change.actions[]? == "delete")] | length' plan.json)
          if [ "$destroys" -gt 0 ]; then
            echo "::error::Apply contains $destroys destructive operation(s). Use a separately reviewed break-glass process."
            exit 1
          fi
      - name: Apply reviewed plan
        working-directory: terraform/live/${{ inputs.layer }}
        run: terraform apply -input=false -auto-approve tfplan
