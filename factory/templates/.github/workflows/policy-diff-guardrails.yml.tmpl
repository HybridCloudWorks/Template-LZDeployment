# GENERATED FILE — Landing Zone Factory v{{FACTORY-RAW:computed.factoryVersion}}
# Renamed from terraform-policy-checks.yml (2026-08-02, WP5): the live repo has
# an unrelated fmt/tflint/tfsec workflow of that name, and a self-regeneration
# would have overwritten it. The job id `policy` is unchanged — it is a
# required-status-check context (broker LZ_REQUIRED_STATUS_CHECKS docs).
name: Policy Diff Guardrails

on:
  pull_request:
    paths:
      - 'terraform/**'
      - '.github/workflows/policy-diff-guardrails.yml'

permissions: {}

jobs:
  policy:
    runs-on: ubuntu-latest
    permissions:
      contents: read
    steps:
      - name: Checkout
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          fetch-depth: 0
      - name: Reject disabled policy enforcement
        shell: bash
        run: |
          set -euo pipefail
          # Three spellings, because this repository carries two policy
          # corpora. `effect = "Audit"` is the bespoke one. The Azure Verified
          # Modules ALZ pattern says `enforcement_mode = "DoNotEnforce"` (the
          # assignment is created but does not act) and `creation_enabled =
          # false` (it is never created at all) — until this step learned them,
          # it read as a control over the ALZ baseline and enforced nothing.
          downgrade='effect[[:space:]]*=[[:space:]]*"(Disabled|Audit)"'
          downgrade="$downgrade"'|enforcement_mode[[:space:]]*=[[:space:]]*"DoNotEnforce"'
          downgrade="$downgrade"'|creation_enabled[[:space:]]*=[[:space:]]*false'

          base="origin/{{FACTORY-RAW:computed.defaultBranch}}"
          failed=0

          # Every stamp in a rendered file is derived from lz-config.json — the
          # factory version and the export timestamp both come out of the answer
          # record, so re-rendering an unchanged record is byte-identical. A
          # moved stamp with an unchanged record therefore means the stamp was
          # hand-edited, and the regeneration exemption below requires both.
          record_changed=0
          if git diff --name-only "$base...HEAD" -- lz-config.json | grep -q .; then
            record_changed=1
          fi
          while IFS= read -r file; do
            [ -n "$file" ] || continue
            hits=$(git diff --unified=0 "$base...HEAD" -- "$file" | grep -E "^\+.*($downgrade)" || true)
            [ -n "$hits" ] || continue

            # A regeneration is not a hand-edit. Every file the factory renders
            # carries its own version-and-timestamp stamp, so a re-export always
            # moves that line and a hand-edit never does — which is why the
            # exemption keys on the stamp moving rather than on the "GENERATED
            # FILE" header merely being present. Editing a generated file in a
            # pull request that does not also re-export the answer record is
            # still caught.
            #
            # Known limit, stated rather than papered over: a pull request that
            # BOTH regenerates a file and hand-edits the same file is not
            # distinguished here. Nothing short of re-running the factory can
            # separate those, and the factory does not run in this repository.
            # Review the lz-config.json diff — it is the reviewable artifact.
            if [ "$record_changed" -eq 1 ] &&
               git diff --unified=0 "$base...HEAD" -- "$file" |
               grep -qE '^\+#[[:space:]]*[0-9]+\.[0-9]+\.[0-9]+ on '; then
              echo "::notice file=$file::Policy downgrade accepted: this file was regenerated, and the wizard's Policies step is where that choice is reviewed."
              continue
            fi

            echo "::error file=$file::Policy enforcement downgrade requires explicit architecture review."
            echo "$hits"
            failed=1
          done < <(git diff --name-only "$base...HEAD" -- terraform/)

          if [ "$failed" -ne 0 ]; then
            echo "::error::Turn the assignment off in the wizard and regenerate, or record the exception with the platform owner. Hand-editing a generated layer is undone by the next render."
            exit 1
          fi
      - name: Reject floating module sources
        shell: bash
        run: |
          if grep -RhnE 'source[[:space:]]*=[[:space:]]*"git::[^"]+"' terraform --include='*.tf' | grep -vE '\?ref='; then
            echo "::error::Git module source is missing an immutable ref."
            exit 1
          fi
