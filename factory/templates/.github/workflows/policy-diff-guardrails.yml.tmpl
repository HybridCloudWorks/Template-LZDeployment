name: Policy Diff Guardrails

on:
  pull_request:
    paths:
      - 'terraform/**'
      - '.github/workflows/policy-diff-guardrails.yml'

permissions: {}

jobs:
  policy:
    runs-on: ubuntu-latest
    permissions:
      contents: read
    steps:
      - name: Checkout
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          fetch-depth: 0
      - name: Reject disabled policy enforcement
        shell: bash
        run: |
          if git diff --unified=0 origin/{{FACTORY-RAW:computed.defaultBranch}}...HEAD -- terraform/ | grep -E '^\+.*effect[[:space:]]*=[[:space:]]*"(Disabled|Audit)"'; then
            echo "::error::Policy enforcement downgrade requires explicit architecture review."
            exit 1
          fi
      - name: Reject floating module sources
        shell: bash
        run: |
          if grep -RhnE 'source[[:space:]]*=[[:space:]]*"git::[^"]+"' terraform --include='*.tf' | grep -vE '\?ref='; then
            echo "::error::Git module source is missing an immutable ref."
            exit 1
          fi
