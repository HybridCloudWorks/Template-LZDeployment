# GENERATED FILE — Landing Zone Factory v{{FACTORY-RAW:computed.factoryVersion}}
name: Action Pinning Policy

on:
  pull_request:
    paths: ['.github/workflows/**']
  push:
    branches: [{{FACTORY-RAW:computed.defaultBranch}}]
    paths: ['.github/workflows/**']

permissions: {}

jobs:
  pinning:
    runs-on: ubuntu-latest
    permissions:
      contents: read
    steps:
      - name: Checkout
        uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2
      - name: Reject mutable action references
        shell: bash
        run: |
          failures=0
          while IFS= read -r ref; do
            case "$ref" in
              ./*|docker://*) continue ;;
            esac
            if ! [[ "$ref" =~ @([0-9a-f]{40})$ ]]; then
              echo "::error::Action is not pinned to a full commit SHA: $ref"
              failures=1
            fi
          done < <(grep -RhoE 'uses:[[:space:]]*[^[:space:]#]+' .github/workflows | sed -E 's/^uses:[[:space:]]*//')
          exit "$failures"
