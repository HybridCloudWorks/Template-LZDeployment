# GENERATED FILE — Landing Zone Factory v{{FACTORY-RAW:computed.factoryVersion}}
name: Azure OIDC Verification

on:
  pull_request:
    paths:
      - '.github/workflows/azure-auth-test.yml'
  schedule:
    - cron: '17 9 * * 1'
  workflow_dispatch:

permissions: {}

jobs:
  verify-plan-identity:
    if: github.event_name != 'pull_request' || github.event.pull_request.head.repo.full_name == github.repository
    runs-on: ubuntu-latest
    permissions:
      id-token: write
      contents: read
    steps:
      - name: Azure login (read-only plan identity)
        uses: azure/login@a457da9ea143d694b1b9c7c869ebb04ebe844ef5 # v2.3.0
        with:
          client-id: ${{ vars.AZURE_PLAN_CLIENT_ID }}
          tenant-id: {{FACTORY-RAW:azure.tenantId}}
          subscription-id: ${{ vars.AZURE_SUBSCRIPTION_ID }}
      - name: Prove the effective identity and refuse write roles
        shell: bash
        run: |
          client_id="${{ vars.AZURE_PLAN_CLIENT_ID }}"
          roles=$(az role assignment list --assignee "$client_id" --all --query '[].roleDefinitionName' -o tsv)
          echo "$roles"
          if echo "$roles" | grep -Eq '^(Owner|Contributor|User Access Administrator)$'; then
            echo "::error::Plan identity has a write-capable role."
            exit 1
          fi
          echo "$roles" | grep -qx 'Reader' || { echo "::error::Reader role was not found."; exit 1; }
