# ─────────────────────────────────────────────────────────────────────────────
# Terraform plan — runs on pull requests.
#
# GENERATED FILE. Do not hand-edit. Rendered from lz-config.json by
# Landing Zone Factory v{{FACTORY-RAW:computed.factoryVersion}}.
#
# This workflow authenticates as the READ-ONLY plan identity. It cannot apply,
# and it cannot assume the apply identity: the apply federated credential is
# bound to `environment:<name>`, a subject a pull_request-triggered run never
# presents. That separation is structural, not procedural.
# ─────────────────────────────────────────────────────────────────────────────
name: Terraform Plan

on:
  pull_request:
    branches: [{{FACTORY-RAW:computed.defaultBranch}}]
    paths:
      - 'terraform/**'
      - '.github/workflows/terraform-plan.yml'

# Least privilege at the workflow root; each job opts in to what it needs.
permissions: {}

concurrency:
  group: terraform-plan-${{ github.ref }}
  cancel-in-progress: true

jobs:
  plan:
    # Forks run terraform-fmt-validate without receiving cloud credentials.
    if: github.event.pull_request.head.repo.full_name == github.repository
    name: Plan (${{ matrix.layer }})
    runs-on: ubuntu-latest
    permissions:
      id-token: write       # OIDC token for Azure federation
      contents: read
      pull-requests: write  # to post the plan summary

    strategy:
      # Serialised deliberately: management group and policy operations are
      # heavily throttled, and parallel plans across layers trip the limit.
      max-parallel: 1
      fail-fast: false
      matrix:
        layer:
#{{FOREACH lyr IN computed.layers}}
          - {{FACTORY-RAW:lyr}}
#{{ENDFOREACH}}

    steps:
      - name: Checkout
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1

      # First-apply pre-flight. management_ip_ranges is a deliberate commented
      # operator placeholder (the wizard never collects operator network
      # ranges — contract #4, .claude/CROSS-DOMAIN-CONTRACTS.md). Left unfilled
      # it surfaces later as a raw "No value for required variable" Terraform
      # error; this step fails fast, before login and init, with an
      # explanation. (The variable is required and wildcard-rejecting — the
      # old wide-open '*' default no longer exists.)
      - name: Pre-flight connectivity operator inputs
        if: matrix.layer == 'platform-connectivity'
        working-directory: terraform/live/${{ matrix.layer }}
        shell: bash
        run: |
          shopt -s nullglob
          set_in=""
          for f in *.tfvars; do
            if grep -Eq '^[[:space:]]*management_ip_ranges[[:space:]]*=' "$f"; then
              set_in="$f"
            fi
          done
          if [ -z "$set_in" ]; then
            echo "::error::management_ip_ranges is not set in terraform/live/platform-connectivity/*.tfvars."
            echo "The wizard deliberately exports it as a commented placeholder in connectivity.auto.tfvars;"
            echo "it must be filled by the operator BEFORE the first connectivity plan. Uncomment the line"
            echo "and supply your management source ranges, for example:"
            echo '  management_ip_ranges = ["203.0.113.0/24"]'
            echo "Wildcards ('*', '0.0.0.0/0') are rejected: they expose firewall management interfaces"
            echo "to every source address. Do not delete the placeholder comment block - fill it in."
            exit 1
          fi
          if grep -Eq '^[[:space:]]*management_ip_ranges[[:space:]]*=[[:space:]]*(\[[[:space:]]*)?"(\*|0\.0\.0\.0/0)"' "$set_in"; then
            echo "::error::management_ip_ranges in $set_in is a wildcard ('*' or '0.0.0.0/0')."
            echo "That exposes firewall management interfaces to every source address. Replace it with"
            echo "the operator's real management CIDR ranges before planning this layer."
            exit 1
          fi
          echo "management_ip_ranges is set in $set_in."

          # Management-workspace wiring. The SUPPORTED path is the remote-state
          # wire: after platform-management's first apply, flip
          # wire_management_workspace = true and the layer reads the workspace
          # ID from platform-management's state — no ID is ever pasted by hand.
          # An explicit log_analytics_workspace_id value remains a deliberate
          # override of the wire (e.g. an externally-owned workspace).
          if grep -Eq '^[[:space:]]*log_analytics_workspace_id[[:space:]]*=[[:space:]]*"?<' *.tfvars; then
            echo "::error::log_analytics_workspace_id still contains the '<...>' placeholder text."
            echo "Do not paste workspace IDs by hand. Re-comment the line; after the platform-management"
            echo "layer applies, set wire_management_workspace = true instead - the value is then read"
            echo "from that layer's remote state. Only set log_analytics_workspace_id explicitly to"
            echo "OVERRIDE the wire with an externally-owned workspace."
            exit 1
          fi
          if grep -Eq '^[[:space:]]*wire_management_workspace[[:space:]]*=[[:space:]]*true' *.tfvars; then
            echo "wire_management_workspace = true: workspace ID is supplied by platform-management remote state."
          elif grep -Eq '^[[:space:]]*log_analytics_workspace_id[[:space:]]*=' *.tfvars; then
            echo "log_analytics_workspace_id set explicitly (deliberate override of the remote-state wire)."
          else
            echo "::warning::No management workspace is wired; hub firewall diagnostics and threat-intel"
            echo "::warning::alerts will not be created. Expected before the first apply: once the"
            echo "::warning::platform-management layer applies, set wire_management_workspace = true"
            echo "::warning::(do not paste the workspace ID into tfvars)."
          fi

      - name: Azure login (plan identity, read-only)
        uses: azure/login@532459ea530d8321f2fb9bb10d1e0bcf23869a43 # v3.0.0
        with:
          client-id: ${{ fromJSON(vars.AZURE_PLAN_CLIENT_IDS)[matrix.layer] }}
          tenant-id: {{FACTORY-RAW:azure.tenantId}}
          subscription-id: ${{ fromJSON(vars.AZURE_SUBSCRIPTION_IDS)[matrix.layer] }}

      - name: Setup Terraform
        uses: hashicorp/setup-terraform@dfe3c3f87815947d99a8997f908cb6525fc44e9e # v4.0.1
        with:
          terraform_version: '{{FACTORY-RAW:computed.terraformVersion}}'
          # Without this, the wrapper echoes a "[command]..." line ahead of
          # stdout, corrupting `terraform show -json` (destroy gate) and the
          # rendered plan.txt that gets posted to the pull request.
          terraform_wrapper: false
#{{IF computed.backendIsHcp}}
          cli_config_credentials_token: ${{ secrets.TF_API_TOKEN }}
#{{ENDIF}}

      - name: Terraform init
        working-directory: terraform/live/${{ matrix.layer }}
        run: terraform init -input=false

      - name: Terraform format check
        working-directory: terraform/live/${{ matrix.layer }}
        run: terraform fmt -check -recursive

      - name: Terraform validate
        working-directory: terraform/live/${{ matrix.layer }}
        run: terraform validate -no-color

      - name: Terraform plan
        id: plan
        working-directory: terraform/live/${{ matrix.layer }}
        run: terraform plan -input=false -no-color -out=tfplan
        continue-on-error: true

      # A plan that destroys resources is treated as a failure by default.
      # Discovering a destroy at apply time is too late; this is the gate.
      - name: Check for destructive operations
        working-directory: terraform/live/${{ matrix.layer }}
        run: |
          terraform show -json tfplan > plan.json
          destroys=$(jq '[.resource_changes[]? | select(.change.actions[]? == "delete")] | length' plan.json)
          echo "Resources scheduled for destruction: $destroys"
          if [ "$destroys" -gt 0 ]; then
            echo "::error::This plan destroys $destroys resource(s) in layer ${{ matrix.layer }}."
            if [ "${{ contains(github.event.pull_request.labels.*.name, 'approved-destroy') }}" != "true" ]; then
              echo "::error::Add the 'approved-destroy' label to acknowledge, after reviewing the plan output."
              exit 1
            fi
            echo "::warning::Destruction acknowledged via the approved-destroy label."
          fi

      - name: Render plan text
        if: steps.plan.outcome == 'success'
        working-directory: terraform/live/${{ matrix.layer }}
        run: terraform show -no-color tfplan > plan.txt

      - name: Upload plan artifact
        if: steps.plan.outcome == 'success'
        uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a # v7.0.1
        with:
          name: tfplan-${{ matrix.layer }}
          path: terraform/live/${{ matrix.layer }}/tfplan
          retention-days: 5

      # Posts the rendered plan to the pull request — the reason this job
      # carries pull-requests: write.
      - name: Comment PR with plan
        uses: actions/github-script@3a2844b7e9c422d3c10d287c895573f7108da1b3 # v9.0.0
        with:
          script: |
            const fs = require('fs');
            const planPath = 'terraform/live/${{ matrix.layer }}/plan.txt';
            const plan = fs.existsSync(planPath)
              ? fs.readFileSync(planPath, 'utf8')
              : '(no plan output produced - see the Terraform plan step log)';
            const truncatedPlan = plan.length > 65000
              ? plan.substring(0, 65000) + '\n\n... (truncated)'
              : plan;
            const body = [
              '### Terraform Plan: `${{ matrix.layer }}`',
              '',
              '#### Plan outcome: `${{ steps.plan.outcome }}`',
              '',
              '<details><summary>Show Plan</summary>',
              '',
              '```terraform',
              truncatedPlan,
              '```',
              '',
              '</details>',
              '',
              '*Pusher: @${{ github.actor }}, Workflow: `${{ github.workflow }}`*',
            ].join('\n');
            github.rest.issues.createComment({
              issue_number: context.issue.number,
              owner: context.repo.owner,
              repo: context.repo.repo,
              body,
            });

      - name: Fail if plan errored
        if: steps.plan.outcome == 'failure'
        run: exit 1
