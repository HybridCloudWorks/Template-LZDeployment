# GENERATED FILE — Landing Zone Factory v{{FACTORY-RAW:computed.factoryVersion}}
name: Security Scan

on:
  pull_request:
  push:
    branches: [{{FACTORY-RAW:computed.defaultBranch}}]

permissions: {}

jobs:
  repository-scan:
    runs-on: ubuntu-latest
    permissions:
      contents: read
    steps:
      - name: Checkout
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          fetch-depth: 0
      - name: Reject private keys and common static credentials
        shell: bash
        run: |
          if git grep -nE -- 'BEGIN (RSA |EC |OPENSSH )?PRIVATE KEY|(^|[^A-Za-z0-9])gh[pousr]_[A-Za-z0-9]{20,}|client_secret[[:space:]]*=' -- . ':(exclude).github/workflows/security-scan.yml'; then
            echo "::error::Potential static credential material found."
            exit 1
          fi
      - name: Check Terraform files for committed plan/state
        shell: bash
        run: |
          bad=$(find . -type f \( -name '*.tfstate' -o -name '*.tfplan' \) -not -path './.git/*' -print)
          if [ -n "$bad" ]; then
            echo "$bad"
            echo "::error::Terraform state or plan files must not be committed."
            exit 1
          fi
