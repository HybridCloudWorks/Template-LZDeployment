# GENERATED FILE — Landing Zone Factory v{{FACTORY-RAW:computed.factoryVersion}}
name: Terraform Format and Validate

on:
  pull_request:
    branches: [{{FACTORY-RAW:computed.defaultBranch}}]
    paths:
      - 'terraform/**'
      - '.github/workflows/terraform-fmt-validate.yml'
  push:
    branches: [{{FACTORY-RAW:computed.defaultBranch}}]
    paths:
      - 'terraform/**'

permissions: {}

concurrency:
  group: terraform-validate-${{ github.ref }}
  cancel-in-progress: true

jobs:
  validate:
    name: Validate (${{ matrix.layer }})
    runs-on: ubuntu-latest
    permissions:
      contents: read
    strategy:
      fail-fast: false
      max-parallel: 1
      matrix:
        layer:
#{{FOREACH lyr IN computed.layers}}
          - {{FACTORY-RAW:lyr}}
#{{ENDFOREACH}}
    steps:
      - name: Checkout
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
      - name: Setup Terraform
        uses: hashicorp/setup-terraform@dfe3c3f87815947d99a8997f908cb6525fc44e9e # v4.0.1
        with:
          terraform_version: '{{FACTORY-RAW:computed.terraformVersion}}'
      - name: Format check
        working-directory: terraform/live/${{ matrix.layer }}
        run: terraform fmt -check -recursive
      - name: Initialize without backend
        working-directory: terraform/live/${{ matrix.layer }}
        run: terraform init -backend=false -input=false
      - name: Validate
        working-directory: terraform/live/${{ matrix.layer }}
        run: terraform validate -no-color
