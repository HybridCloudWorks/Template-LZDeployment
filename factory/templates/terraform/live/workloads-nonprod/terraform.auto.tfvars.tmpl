# NSG flow logs. Your wizard answer for "NSG flow logs" was
# {{FACTORY-BOOL:security.nsgFlowLogs.enabled}} — it is recorded in
# lz-config.json, and this flag is still rendered false. Same reason as the
# production layer: the module reads NetworkWatcher_<region> in
# NetworkWatcherRG, which Azure creates only once this subscription's first
# VNet exists, so enabling it before the spokes exist would make your very
# first plan fail. Flip this to true in a PR after the spokes' first apply
# (and after platform-connectivity's wire_management_workspace is on). One
# instance per region covers all three nonprod spokes — the flow-log storage
# account name is globally unique per region and environment, so a second
# instance in the same region would collide. Until then no flow logs are
# collected and no flow-log meter bills. The two settings below are already
# your answers and take effect the moment you flip it.
enable_nsg_flow_logs     = false
flow_log_retention_days  = {{FACTORY-NUM:security.nsgFlowLogs.retentionDays}}
enable_traffic_analytics = {{FACTORY-BOOL:security.nsgFlowLogs.trafficAnalytics}}

# Your "Private endpoints" answer. It ANDs with the connectivity layer's
# private DNS zone: no zone means no endpoint regardless, because an endpoint
# without a matching zone resolves to nothing. Untick it and no private
# endpoint is created here even once the zone exists.
enable_private_endpoints = {{FACTORY-BOOL:connectivity.privateEndpoints.enabled}}

default_tags = {{FACTORY-MAP:naming.defaultTags}}
