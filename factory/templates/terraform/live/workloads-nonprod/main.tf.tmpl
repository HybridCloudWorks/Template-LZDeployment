# GENERATED FILE. Do not hand-edit. Rendered from lz-config.json by
# Landing Zone Factory v{{FACTORY-RAW:computed.factoryVersion}}.

terraform {
  required_providers {
    azurerm = {
      source  = "hashicorp/azurerm"
      version = "~> 5.0"
    }
  }
}

provider "azurerm" {
  features {}
  # Stated 5.0 default (decision 0006): the provider registers no resource
  # providers — the broker registers the required namespaces at bootstrap.
  subscription_id                 = var.workload_nonprod_subscription_id
  resource_provider_registrations = "none"
}

#{{IF connectivity.model != 'none'}}
# The hub side of each VNet peering must be created in the connectivity
# subscription that owns the hub VNet, not in the workload subscription.
provider "azurerm" {
  alias                           = "hub"
  subscription_id                 = var.connectivity_subscription_id
  resource_provider_registrations = "none"
  features {}
}
#{{ENDIF}}

#{{IF connectivity.model != 'none'}}
data "terraform_remote_state" "connectivity" {
#{{IF computed.backendIsHcp}}
  backend = "remote"
  config = {
    organization = {{FACTORY:backend.hcpTerraform.organization}}
    workspaces = {
      name = "{{FACTORY-RAW:computed.workspacePrefix}}-platform-connectivity"
    }
  }
#{{ELSE}}
  backend = "azurerm"
  config = {
    resource_group_name  = var.state_resource_group_name
    storage_account_name = var.state_storage_account_name
    container_name       = var.state_container_name
    key                  = "platform-connectivity.tfstate"
    # The state storage account disables shared keys; without AAD auth this
    # read fails with a 403 at init. Must match backend.tf's auth mode.
    use_azuread_auth = {{FACTORY-BOOL:backend.azurerm.useAzureAdAuth}}
  }
#{{ENDIF}}
}
#{{ENDIF}}

locals {
#{{IF connectivity.model != 'none'}}
  primary_hub = data.terraform_remote_state.connectivity.outputs.primary_hub_details
#{{IF computed.hasDrRegion}}
  dr_hub = data.terraform_remote_state.connectivity.outputs.dr_hub_details
#{{ENDIF}}

  # The connectivity layer re-exports the central Log Analytics workspace as a
  # triple (decision 0009, choice B1); try() covers a connectivity state
  # applied before that output existed. This is a lookup against a value
  # already in state, not a provider read.
  management_workspace = try(
    data.terraform_remote_state.connectivity.outputs.management_workspace,
    { resource_id = "", guid = "", location = "" }
  )

  # Every non-production spoke in a region shares ONE flow-log instance with
  # environment = "nonprod", because this call takes the module's composed name
  # stflowlogs${region_code}${environment} and storage account names are
  # globally unique — a second instance in that (region, environment) would
  # have to supply storage_account_name explicitly, as the connectivity layer's
  # hub instances do. The map keys are prefixed per spoke: the module uses the
  # key in the flow-log resource name, which must stay unique within the
  # region's Network Watcher, and three spokes each contribute an "app" NSG.
  nonprod_nsg_ids_primary = {
#{{IF environments.application contains 'dev'}}
    "dev-app"  = module.spoke_dev_primary.nsg_ids.app
    "dev-data" = module.spoke_dev_primary.nsg_ids.data
    "dev-pe"   = module.spoke_dev_primary.nsg_ids.pe
#{{ENDIF}}
#{{IF environments.application contains 'test'}}
    "test-app"  = module.spoke_test_primary.nsg_ids.app
    "test-data" = module.spoke_test_primary.nsg_ids.data
    "test-pe"   = module.spoke_test_primary.nsg_ids.pe
#{{ENDIF}}
#{{IF environments.application contains 'uat'}}
    "uat-app"  = module.spoke_uat_primary.nsg_ids.app
    "uat-data" = module.spoke_uat_primary.nsg_ids.data
    "uat-pe"   = module.spoke_uat_primary.nsg_ids.pe
#{{ENDIF}}
  }

  # The shared instance's storage account and diagnostic settings need one
  # resource group; a non-production region has no single owning group, so the
  # first rendered spoke's group holds them.
#{{IF environments.application contains 'dev'}}
  nonprod_flow_log_rg_primary = module.spoke_dev_primary.resource_group_name
#{{ELSEIF environments.application contains 'test'}}
  nonprod_flow_log_rg_primary = module.spoke_test_primary.resource_group_name
#{{ELSE}}
  nonprod_flow_log_rg_primary = module.spoke_uat_primary.resource_group_name
#{{ENDIF}}
#{{IF computed.hasDrRegion}}

  nonprod_nsg_ids_dr = {
#{{IF environments.application contains 'dev'}}
    "dev-app"  = module.spoke_dev_dr.nsg_ids.app
    "dev-data" = module.spoke_dev_dr.nsg_ids.data
    "dev-pe"   = module.spoke_dev_dr.nsg_ids.pe
#{{ENDIF}}
#{{IF environments.application contains 'test'}}
    "test-app"  = module.spoke_test_dr.nsg_ids.app
    "test-data" = module.spoke_test_dr.nsg_ids.data
    "test-pe"   = module.spoke_test_dr.nsg_ids.pe
#{{ENDIF}}
#{{IF environments.application contains 'uat'}}
    "uat-app"  = module.spoke_uat_dr.nsg_ids.app
    "uat-data" = module.spoke_uat_dr.nsg_ids.data
    "uat-pe"   = module.spoke_uat_dr.nsg_ids.pe
#{{ENDIF}}
  }

#{{IF environments.application contains 'dev'}}
  nonprod_flow_log_rg_dr = module.spoke_dev_dr.resource_group_name
#{{ELSEIF environments.application contains 'test'}}
  nonprod_flow_log_rg_dr = module.spoke_test_dr.resource_group_name
#{{ELSE}}
  nonprod_flow_log_rg_dr = module.spoke_uat_dr.resource_group_name
#{{ENDIF}}
#{{ENDIF}}
#{{ENDIF}}
}

