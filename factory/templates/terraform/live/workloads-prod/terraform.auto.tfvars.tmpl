workload_prod_subscription_id = {{FACTORY:azure.subscriptions.workloadProd}}

#{{IF connectivity.model != 'none'}}
# The hub side of each spoke peering is created in the connectivity
# subscription through the azurerm.hub provider alias.
connectivity_subscription_id = {{FACTORY:azure.subscriptions.connectivity}}
#{{ENDIF}}

#{{IF computed.backendIsAzurerm}}
# The connectivity layer's outputs are read through its state. Under the
# azurerm backend that read is addressed by storage account; under HCP
# Terraform it is addressed by organization and workspace, and these two
# variables are unused.
state_resource_group_name  = {{FACTORY:backend.azurerm.resourceGroupName}}
state_storage_account_name = {{FACTORY:backend.azurerm.storageAccountName}}
state_container_name       = {{FACTORY:backend.azurerm.containerName}}
#{{ENDIF}}

primary_region      = {{FACTORY:azure.primaryRegion}}
primary_region_code = {{FACTORY:azure.primaryRegionCode}}
#{{IF computed.hasDrRegion}}
dr_region      = {{FACTORY:azure.drRegion}}
dr_region_code = {{FACTORY:azure.drRegionCode}}
#{{ENDIF}}

primary_spoke_address_space = {{FACTORY:connectivity.hubSpoke.primarySpokeAddressSpace}}
#{{IF computed.hasDrRegion}}
dr_spoke_address_space = {{FACTORY:connectivity.hubSpoke.drSpokeAddressSpace}}
#{{ENDIF}}

# NSG flow logs. Your wizard answer for "NSG flow logs" was
# {{FACTORY-BOOL:security.nsgFlowLogs.enabled}} — it is recorded in
# lz-config.json, and this flag is still rendered false. That is deliberate,
# not a rendering bug: the module reads NetworkWatcher_<region> in
# NetworkWatcherRG, which Azure creates only once this subscription's first
# VNet exists, so an enabled-on-day-one flow-log call would make your very
# first plan fail. Flip this to true in a PR after the spokes' first apply
# (and after platform-connectivity's wire_management_workspace is on, which
# supplies the Log Analytics workspace Traffic Analytics needs). Until then no
# flow logs are collected and no flow-log meter bills. The two settings below
# are already your answers and take effect the moment you flip it.
enable_nsg_flow_logs     = false
flow_log_retention_days  = {{FACTORY-NUM:security.nsgFlowLogs.retentionDays}}
enable_traffic_analytics = {{FACTORY-BOOL:security.nsgFlowLogs.trafficAnalytics}}

# Your "Private endpoints" answer. It ANDs with the connectivity layer's
# private DNS zone: no zone means no endpoint regardless, because an endpoint
# without a matching zone resolves to nothing. Untick it and no private
# endpoint is created here even once the zone exists.
enable_private_endpoints = {{FACTORY-BOOL:connectivity.privateEndpoints.enabled}}

# DATA RESIDENCY (TODO item 2.8). Flow-log storage defaults to RAGZRS, which
# asynchronously replicates every flow log to the Azure paired region AND makes
# it readable there. For a US estate that is unremarkable. Under an EU/UK data
# boundary or a single-country sovereignty commitment it moves network metadata
# across the boundary — uncomment and set LRS (or ZRS, where the region has
# availability zones) to keep every copy in one region.
# flow_log_storage_replication_type = "ZRS"

default_tags = {{FACTORY-MAP:naming.defaultTags}}
