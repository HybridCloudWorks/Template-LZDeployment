# ─────────────────────────────────────────────────────────────────────────────
# Production workload layer — application spokes.
#
# GENERATED FILE. Do not hand-edit. Rendered from lz-config.json by
# Landing Zone Factory v{{FACTORY-RAW:computed.factoryVersion}}.
#
# Deploy after platform-connectivity: the spokes read the hub's identifiers out
# of that layer's state.
# ─────────────────────────────────────────────────────────────────────────────

terraform {
  required_providers {
    azurerm = {
      source  = "hashicorp/azurerm"
      version = "~> 5.0"
    }
  }
}

provider "azurerm" {
  features {}
  subscription_id = var.workload_prod_subscription_id
}

#{{IF connectivity.model != 'none'}}
# The hub side of each VNet peering must be created in the connectivity
# subscription that owns the hub VNet, not in the workload subscription.
provider "azurerm" {
  alias           = "hub"
  subscription_id = var.connectivity_subscription_id
  features {}
}


# Hub identifiers come from the connectivity layer's state rather than from
# variables. Layers keep separate state (control AR3), so this read is the only
# supported coupling between them — copying hub IDs into tfvars would silently
# go stale the first time the hub is rebuilt.
data "terraform_remote_state" "connectivity" {
#{{IF computed.backendIsHcp}}
  backend = "remote"

  config = {
    organization = {{FACTORY:backend.hcpTerraform.organization}}

    workspaces = {
      name = "{{FACTORY-RAW:computed.workspacePrefix}}-platform-connectivity"
    }
  }
#{{ELSE}}
  backend = "azurerm"

  config = {
    resource_group_name  = var.state_resource_group_name
    storage_account_name = var.state_storage_account_name
    container_name       = var.state_container_name
    key                  = "platform-connectivity.tfstate"
    # The state storage account disables shared keys; without AAD auth this
    # read fails with a 403 at init. Must match backend.tf's auth mode.
    use_azuread_auth = {{FACTORY-BOOL:backend.azurerm.useAzureAdAuth}}
  }
#{{ENDIF}}
}
#{{ENDIF}}

locals {
#{{IF connectivity.model != 'none'}}
  primary_hub = data.terraform_remote_state.connectivity.outputs.primary_hub_details
#{{IF computed.hasDrRegion}}
  dr_hub = data.terraform_remote_state.connectivity.outputs.dr_hub_details
#{{ENDIF}}
#{{ENDIF}}

  common_tags = merge(var.default_tags, {
    layer = "workload-prod"
  })
}

module "spoke_prod_primary" {
  source = "../../modules/spoke-network"

#{{IF connectivity.model != 'none'}}
  providers = {
    azurerm     = azurerm
    azurerm.hub = azurerm.hub
  }
#{{ELSE}}
  # No hub exists, so the module's azurerm.hub alias is satisfied with the
  # spoke's own provider; no hub-side peering resources are created.
  providers = {
    azurerm     = azurerm
    azurerm.hub = azurerm
  }
#{{ENDIF}}

  spoke_name          = "prod-app"
  region              = var.primary_region
  region_code         = var.primary_region_code
  environment         = "prod"
  spoke_address_space = var.primary_spoke_address_space
#{{IF connectivity.model != 'none'}}
  enable_hub_peering      = true
  hub_vnet_id             = local.primary_hub.vnet_id
  hub_vnet_name           = local.primary_hub.vnet_name
  hub_resource_group_name = local.primary_hub.resource_group_name
  enable_forced_tunneling = true
  firewall_private_ip     = local.primary_hub.firewall_private_ip
#{{ELSE}}
  # No platform hub exists in this landing zone, so there is nothing to peer to
  # and no firewall to force-tunnel through.
  enable_hub_peering      = false
  enable_forced_tunneling = false
#{{ENDIF}}
  use_remote_gateways = false
  tags                = local.common_tags
}

#{{IF computed.hasDrRegion}}
module "spoke_prod_dr" {
  source = "../../modules/spoke-network"

#{{IF connectivity.model != 'none'}}
  providers = {
    azurerm     = azurerm
    azurerm.hub = azurerm.hub
  }
#{{ELSE}}
  providers = {
    azurerm     = azurerm
    azurerm.hub = azurerm
  }
#{{ENDIF}}

  spoke_name          = "prod-app"
  region              = var.dr_region
  region_code         = var.dr_region_code
  environment         = "prod"
  spoke_address_space = var.dr_spoke_address_space
#{{IF connectivity.model != 'none'}}
  enable_hub_peering      = true
  hub_vnet_id             = local.dr_hub.vnet_id
  hub_vnet_name           = local.dr_hub.vnet_name
  hub_resource_group_name = local.dr_hub.resource_group_name
  enable_forced_tunneling = true
  firewall_private_ip     = local.dr_hub.firewall_private_ip
#{{ELSE}}
  enable_hub_peering      = false
  enable_forced_tunneling = false
#{{ENDIF}}
  use_remote_gateways = false
  tags                = local.common_tags
}
#{{ENDIF}}
