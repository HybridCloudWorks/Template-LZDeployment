# ─────────────────────────────────────────────────────────────────────────────
# platform-connectivity — Azure Verified Modules root module.
#
# GENERATED FILE. Do not hand-edit. Rendered by Landing Zone Factory
# {{FACTORY-RAW:computed.factoryVersion}} on {{FACTORY-RAW:computed.generatedAt}}.
#
# Exactly one topology is emitted, chosen by the configuration's
# connectivity.model answer — hub-and-spoke or Virtual WAN, never both.
# The pattern module is referenced from the Terraform Registry by pinned
# version; nothing is vendored. Renovate keeps the pin current.
#
# The module input structures below were composed against the modules' actual
# variables.tf at the pinned tags (hub-and-spoke v0.17.3 / virtual-wan
# v0.17.1). The modules do not create resource groups — this root module does,
# and passes their IDs as the parent for every hub-scoped resource.
# ─────────────────────────────────────────────────────────────────────────────

terraform {
  # The hub-and-spoke pattern module requires Terraform ~> 1.12 (verified
  # against the module's terraform.tf at tag v0.17.3).
  required_version = ">= 1.12.0"

  required_providers {
    azurerm = {
      source  = "hashicorp/azurerm"
      version = "~> 4.0"
    }
  }
}

provider "azurerm" {
  features {}
  subscription_id                 = var.connectivity_subscription_id
  resource_provider_registrations = "none"
}

locals {
  # AzureFirewallSubnet and AzureBastionSubnet need a /26, GatewaySubnet a /27.
  # Carved deterministically from the front of each hub's address space.
  primary_prefix_length   = tonumber(split("/", var.primary_hub_address_space)[1])
  primary_firewall_subnet = cidrsubnet(var.primary_hub_address_space, 26 - local.primary_prefix_length, 0)
  primary_bastion_subnet  = cidrsubnet(var.primary_hub_address_space, 26 - local.primary_prefix_length, 1)
  primary_gateway_subnet  = cidrsubnet(var.primary_hub_address_space, 27 - local.primary_prefix_length, 4)

  has_dr = var.dr_hub_address_space != ""

  dr_prefix_length   = local.has_dr ? tonumber(split("/", var.dr_hub_address_space)[1]) : 0
  dr_firewall_subnet = local.has_dr ? cidrsubnet(var.dr_hub_address_space, 26 - local.dr_prefix_length, 0) : null
  dr_bastion_subnet  = local.has_dr ? cidrsubnet(var.dr_hub_address_space, 26 - local.dr_prefix_length, 1) : null
  dr_gateway_subnet  = local.has_dr ? cidrsubnet(var.dr_hub_address_space, 27 - local.dr_prefix_length, 4) : null

  hub_definitions = merge(
    {
      primary = {
        region        = var.primary_region
        region_code   = var.primary_region_code
        address_space = var.primary_hub_address_space
        firewall_snet = local.primary_firewall_subnet
        bastion_snet  = local.primary_bastion_subnet
        gateway_snet  = local.primary_gateway_subnet
      }
    },
    local.has_dr ? {
      dr = {
        region        = var.dr_region
        region_code   = var.dr_region_code
        address_space = var.dr_hub_address_space
        firewall_snet = local.dr_firewall_subnet
        bastion_snet  = local.dr_bastion_subnet
        gateway_snet  = local.dr_gateway_subnet
      }
    } : {}
  )
}

# The pattern modules require existing resource groups (parent IDs); one per
# hub region, owned by this root module.
resource "azurerm_resource_group" "connectivity" {
  for_each = local.hub_definitions

  name     = "rg-${var.org_prefix}-connectivity-${each.value.region_code}"
  location = each.value.region
  tags     = var.default_tags
}

#{{IF computed.topologyIsHubSpoke}}
# ─── Hub-and-spoke ───────────────────────────────────────────────────────────

module "hub_and_spoke_vnet" {
  source  = "Azure/avm-ptn-alz-connectivity-hub-and-spoke-vnet/azurerm"
  version = "0.17.3"

  hub_and_spoke_networks_settings = var.hub_and_spoke_networks_settings

  hub_virtual_networks = {
    for key, hub in local.hub_definitions :
    key => {
      location          = hub.region
      default_parent_id = azurerm_resource_group.connectivity[key].id

      enabled_resources = {
        firewall                              = var.firewall_enabled
        firewall_policy                       = var.firewall_enabled
        bastion                               = var.deploy_bastion
        virtual_network_gateway_express_route = var.deploy_expressroute_gateway
        virtual_network_gateway_vpn           = var.deploy_vpn_gateway
        private_dns_zones                     = var.deploy_private_dns
        private_dns_resolver                  = false
        dns_resolver_policy                   = false
      }

      hub_virtual_network = {
        name          = "vnet-hub-${hub.region_code}"
        address_space = [hub.address_space]
        tags          = var.default_tags
      }

      firewall = {
        name                  = "afw-hub-${hub.region_code}"
        sku_tier              = var.azfw_tier
        subnet_address_prefix = hub.firewall_snet
        zones                 = var.availability_zones
        tags                  = var.default_tags
      }

      bastion = {
        name                  = "bas-hub-${hub.region_code}"
        subnet_address_prefix = hub.bastion_snet
        tags                  = var.default_tags
      }

      virtual_network_gateways = {
        subnet_address_prefix = hub.gateway_snet
      }
    }
  }

  tags = var.default_tags
}
#{{ELSE}}
# ─── Virtual WAN ─────────────────────────────────────────────────────────────

module "virtual_wan" {
  source  = "Azure/avm-ptn-alz-connectivity-virtual-wan/azurerm"
  version = "0.17.1"

  virtual_wan_settings = {
    virtual_wan = {
      name                = "vwan-${var.org_prefix}"
      location            = var.primary_region
      resource_group_name = azurerm_resource_group.connectivity["primary"].name
    }
  }

  virtual_hubs = {
    for key, hub in local.hub_definitions :
    key => {
      location          = hub.region
      default_parent_id = azurerm_resource_group.connectivity[key].id

      enabled_resources = {
        firewall                              = var.firewall_enabled
        firewall_policy                       = var.firewall_enabled
        bastion                               = false
        virtual_network_gateway_express_route = var.deploy_expressroute_gateway
        virtual_network_gateway_vpn           = var.deploy_vpn_gateway
        private_dns_zones                     = false
        private_dns_resolver                  = false
      }

      hub = {
        name           = "vhub-${hub.region_code}"
        address_prefix = hub.address_space
      }

      firewall = {
        name     = "afw-vhub-${hub.region_code}"
        sku_tier = var.azfw_tier
        zones    = [for zone in var.availability_zones : tonumber(zone)]
        tags     = var.default_tags
      }
    }
  }

  tags = var.default_tags
}
#{{ENDIF}}
