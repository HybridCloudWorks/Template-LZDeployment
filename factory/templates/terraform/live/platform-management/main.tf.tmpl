  log_analytics_workspace_name = "log-${var.org_prefix}-management-${var.primary_region_code}"
  automation_account_name      = "aa-${var.org_prefix}-management-${var.primary_region_code}"

  log_analytics_workspace_retention_in_days = var.log_retention_days

  tags = var.default_tags
