# Your "Assign policy denying public network access on PaaS" answer. The
# initiative is scoped to the Landing Zones management group — never to the
# platform group, which holds the Terraform state account your own machine has
# to reach to create this estate.
#
# The effect is Audit, NOT Deny, and that is deliberate: this estate creates
# storage accounts that keep public network access enabled behind network
# rules (the NSG flow-log accounts, and the state account during setup), so a
# Deny would fail your first apply on the platform's own resources. Tighten
# public_network_access_effect to "Deny" in a PR once those are behind private
# endpoints.
assign_public_network_access_policy = {{FACTORY-BOOL:connectivity.privateEndpoints.denyPublicNetworkAccessPolicy}}
public_network_access_effect        = "Audit"
