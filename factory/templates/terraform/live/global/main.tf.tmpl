# ─────────────────────────────────────────────────────────────────────────────
# global — Azure Verified Modules root module (ALZ core).
#
# GENERATED FILE. Do not hand-edit. Rendered by Landing Zone Factory
# {{FACTORY-RAW:computed.factoryVersion}} on {{FACTORY-RAW:computed.generatedAt}}.
#
# Management-group hierarchy, policy definitions, policy assignments, and
# subscription placement come from the Azure Landing Zones library (pinned
# below) through the ALZ provider and the avm-ptn-alz pattern module — by
# REFERENCE, never vendored. The module downloads the library into .alzlib/
# at plan time; that directory is gitignored and must never be committed.
#
# Deploy order: platform-management FIRST (this layer reads its state for the
# Log Analytics workspace policy default), then this layer, then connectivity.
# ─────────────────────────────────────────────────────────────────────────────

terraform {
  # avm-ptn-alz 0.21.x requires Terraform >= 1.12 (verified against the
  # module's terraform.tf at tag v0.21.0).
  required_version = ">= 1.12.0"

  required_providers {
    alz = {
      source  = "Azure/alz"
      version = "~> 0.21.0"
    }
    azapi = {
      source  = "Azure/azapi"
      version = "~> 2.12"
    }
    azurerm = {
      source  = "hashicorp/azurerm"
      version = "~> 4.0"
    }
  }
}

provider "azurerm" {
  features {}
  subscription_id                 = var.management_subscription_id
  resource_provider_registrations = "none"
}

provider "azapi" {}

provider "alz" {
  # Pinned ALZ library release. Bumped deliberately, never implicitly — the
  # library defines the policy surface of the whole estate.
  library_references = [
    {
      path = "{{FACTORY-RAW:computed.alzLibraryPath}}"
      ref  = "{{FACTORY-RAW:computed.alzLibraryRef}}"
    },
#{{IF computed.hasCustomArchitecture}}
    # A local library carrying this estate's own architecture definition. It
    # composes with the pinned one rather than replacing it: every archetype,
    # policy definition and assignment still comes from the ref above, and the
    # local file only says what the management groups are called. custom_url
    # conflicts with path/ref, so it has to be its own entry.
    {
      custom_url = "${path.root}/lib"
    }
#{{ENDIF}}
  ]
}

data "azurerm_client_config" "current" {}

# The management layer owns the workspace; its state is the only permitted
# source for the policy default. Applying this layer before platform-management
# fails here, by design, rather than assigning policies with a dangling scope.
data "terraform_remote_state" "management" {
  backend = "azurerm"

  config = {
    resource_group_name  = var.state_resource_group_name
    storage_account_name = var.state_storage_account_name
    container_name       = var.state_container_name
    key                  = "platform-management.tfstate"
    use_oidc             = true
    use_azuread_auth     = true
  }
}

# ─────────────────────────────────────────────────────────────────────────────
# Subscription placement. The pattern module places each supplied subscription
# under its management group natively (subscription_placement input, verified
# at v0.21.0). A slot left empty in the configuration places nothing.
# ─────────────────────────────────────────────────────────────────────────────

locals {
  subscription_placements = {
    management = {
      subscription_id       = var.management_subscription_id
      management_group_name = var.management_management_group_id
    }
    connectivity = {
      subscription_id       = var.connectivity_subscription_id
      management_group_name = var.connectivity_management_group_id
    }
    identity = {
      subscription_id       = var.identity_subscription_id
      management_group_name = var.identity_management_group_id
    }
    workload_prod = {
      subscription_id       = var.workload_prod_subscription_id
      management_group_name = var.workload_management_group_id
    }
    workload_nonprod = {
      subscription_id       = var.workload_nonprod_subscription_id
      management_group_name = var.workload_management_group_id
    }
    sandbox = {
      subscription_id       = var.sandbox_subscription_id
      management_group_name = var.sandbox_management_group_id
    }
  }

  active_placements = {
    for slot, placement in local.subscription_placements :
    slot => placement if placement.subscription_id != ""
  }

  # policy_assignments_to_modify is keyed by MANAGEMENT GROUP, not by
  # assignment, and most of the library's assignments are carried by more than
  # one group — so the same change has to be repeated under every group that
  # carries it. Inverting here rather than spelling the map out keeps the
  # rendered layer readable and keeps the assignment -> group edge in exactly
  # one place: the generated policy catalog the wizard also reads.
  policy_assignment_scopes = distinct(flatten(values(var.policy_assignment_management_groups)))

  policy_assignments_to_modify = {
    for management_group in local.policy_assignment_scopes : management_group => {
      policy_assignments = {
        for name, change in var.policy_assignment_changes :
        # A null attribute is not "set to null": the module's own
        # optional(bool, true) / optional(string, null) defaults apply, so an
        # unset half of a change leaves the library's value alone.
        name => {
          creation_enabled = change.creation_enabled
          enforcement_mode = change.enforcement_mode
        }
        if contains(lookup(var.policy_assignment_management_groups, name, []), management_group)
      }
    }
  }
}

module "alz" {
  source  = "Azure/avm-ptn-alz/azurerm"
  version = "0.21.0"

  architecture_name  = var.architecture_name
  location           = var.primary_region
  parent_resource_id = var.root_parent_management_group_id != "" ? var.root_parent_management_group_id : data.azurerm_client_config.current.tenant_id

  # Every value the pinned ALZ library declares that this estate can answer.
  # An unsupplied one does not fail: the assignment is created from the
  # placeholder in the library's own assignment file — an all-zeroes
  # subscription, or security_contact@replace_me — and that only surfaces at
  # plan or remediation time. factory/ci/Test-AlzPolicyDefaults.ps1 fails the
  # build for any declared value that is neither supplied here nor waived.
  #
  # Every one of the fourteen is supplied. Twelve are derived from platform
  # facts; ddos_protection_plan_id and email_security_contact are client
  # answers, carried here from the wizard's Policies step.
  # Only what the client changed. An assignment with no entry here is created
  # exactly as the pinned library declares it, which is what keeps a library
  # bump from being silently narrowed by an older answer record.
  policy_assignments_to_modify = local.policy_assignments_to_modify

  policy_default_values = {
    log_analytics_workspace_id = jsonencode({
      value = data.terraform_remote_state.management.outputs.log_analytics_workspace_id
    })

    # Azure Monitor Agent estate, owned by platform-management. Read through
    # remote state, which the documented deploy order already allows:
    # management applies before this layer.
    ama_user_assigned_managed_identity_id = jsonencode({
      value = data.terraform_remote_state.management.outputs.ama_user_assigned_identity_id
    })
    ama_user_assigned_managed_identity_name = jsonencode({
      value = data.terraform_remote_state.management.outputs.ama_user_assigned_identity_name
    })
    ama_vm_insights_data_collection_rule_id = jsonencode({
      value = data.terraform_remote_state.management.outputs.dcr_vm_insights_id
    })
    ama_mdfc_sql_data_collection_rule_id = jsonencode({
      value = data.terraform_remote_state.management.outputs.dcr_defender_sql_id
    })
    ama_change_tracking_data_collection_rule_id = jsonencode({
      value = data.terraform_remote_state.management.outputs.dcr_change_tracking_id
    })

    # Private DNS. Composed from config rather than read from
    # platform-connectivity, which applies AFTER this layer — reading it back
    # would invert the deploy order. Safe because Deploy-Private-DNS-Zones
    # consumes these as strings it writes into records, not as references to
    # resources that must already exist. The resource-group name matches the
    # one the connectivity layer creates its zones in.
    private_dns_zone_subscription_id = jsonencode({
      value = var.connectivity_subscription_id
    })
    private_dns_zone_resource_group_name = jsonencode({
      value = "rg-${var.org_prefix}-connectivity-${var.primary_region_code}"
    })
    private_dns_zone_region = jsonencode({
      value = var.primary_region
    })

    # Resource groups the DINE policies create for themselves. These names do
    # not have to exist yet; they are what the policy will name what it makes.
    resource_group_location = jsonencode({
      value = var.primary_region
    })
    resource_group_name_service_health_alerts = jsonencode({
      value = "rg-${var.org_prefix}-svchealth-${var.primary_region_code}"
    })
    resource_group_name_mdfc = jsonencode({
      value = "rg-${var.org_prefix}-mdfc-${var.primary_region_code}"
    })

    # The two the client answers rather than the factory derives. Both are
    # empty when no selected assignment consumes them — render guard G28
    # refuses the configuration when one is selected and unanswered, which is
    # the only place this is visible before apply.
    ddos_protection_plan_id = jsonencode({
      value = var.ddos_protection_plan_id
    })
    email_security_contact = jsonencode({
      value = var.email_security_contact
    })
  }

  subscription_placement = local.active_placements
}
