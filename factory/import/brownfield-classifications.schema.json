{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hcw.example/schemas/brownfield-classifications.schema.json",
  "title": "Landing Zone Factory Brownfield Classifications",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "inventorySha256", "resources"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "inventorySha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "Pins classifications to the exact discovery inventory."
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "classification"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "classification": {
            "enum": ["adopt", "ignore", "replace", "require-approval"]
          },
          "terraformAddress": {
            "type": "string",
            "pattern": "^$|^(?:module\\.[A-Za-z0-9_-]+(?:\\[[^\\r\\n]+\\])?\\.)*[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+(?:\\[[^\\r\\n]+\\])?$"
          },
          "layer": {
            "type": "string",
            "pattern": "^$|^[a-z0-9-]+$"
          },
          "approvalReference": { "type": "string" },
          "notes": { "type": "string" }
        },
        "allOf": [
          {
            "if": { "properties": { "classification": { "const": "adopt" } } },
            "then": { "required": ["terraformAddress", "layer"] }
          },
          {
            "if": {
              "properties": {
                "classification": {
                  "enum": ["replace", "require-approval"]
                }
              }
            },
            "then": { "required": ["approvalReference"] }
          }
        ]
      }
    }
  }
}
